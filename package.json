{
  "name": "enzyme-stability-ml",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --names \"ml,api,web\" --prefix-colors \"magenta.bold,cyan.bold,green.bold\" --handle-input \"npm:dev:ml\" \"npm:dev:api\" \"npm:dev:web\"",
    "dev:ml": "python -m uvicorn main:app --app-dir ml-service --host 127.0.0.1 --port 8000",
    "dev:api": "npm --prefix backend run dev",
    "dev:web": "vite",
    "setup": "npm install && npm --prefix backend install && pip install -r ml-service/requirements.txt",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "lucide-react": "^1.16.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.15.1",
    "recharts": "^3.8.1",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "vite": "^8.0.4"
  }
}
